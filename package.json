{
    "name": "react-starter-template",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "description": "Minimal React starter template with Vite, TypeScript, UnoCSS, and Zustand.",
    "author": {
        "name": "Denish Sharma",
        "email": "denishcommon@gmail.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/denishsharma/react-starter-template.git"
    },
    "bugs": {
        "url": "https://github.com/denishsharma/react-starter-template/issues"
    },
    "keywords": [
        "starter",
        "template",
        "react",
        "vite",
        "typescript",
        "unocss",
        "zustand",
        "tanstack",
        "react-query",
        "router",
        "store"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint . --fix",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "prepare": "simple-git-hooks"
    },
    "dependencies": {
        "@vercel/analytics": "^1.5.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^4.2.0",
        "@antfu/utils": "^8.1.0",
        "@eslint-react/eslint-plugin": "^1.26.2",
        "@iconify/json": "^2.2.305",
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/plugin-svgo": "^8.1.0",
        "@tanstack/eslint-plugin-query": "^5.66.1",
        "@tanstack/react-query": "^5.66.0",
        "@tanstack/react-query-devtools": "^5.66.0",
        "@tanstack/react-router": "^1.102.5",
        "@tanstack/router-devtools": "^1.102.5",
        "@tanstack/router-vite-plugin": "^1.102.5",
        "@types/node": "^22.13.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@typescript-eslint/eslint-plugin": "^8.24.0",
        "@typescript-eslint/parser": "^8.24.0",
        "@unhead/addons": "^1.11.18",
        "@unocss/eslint-plugin": "^65.4.3",
        "@vitejs/plugin-react": "^4.3.4",
        "axios": "^1.7.9",
        "clsx": "^2.1.1",
        "defu": "^6.1.4",
        "eslint": "^9.20.1",
        "eslint-plugin-format": "^1.0.1",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "immer": "^10.1.1",
        "lint-staged": "^15.4.3",
        "ohash": "^1.1.4",
        "overlayscrollbars": "^2.10.1",
        "overlayscrollbars-react": "^0.5.6",
        "perfect-debounce": "^1.0.0",
        "radash": "^12.1.0",
        "react-use": "^17.6.0",
        "sass": "^1.84.0",
        "simple-git-hooks": "^2.11.1",
        "std-env": "^3.8.0",
        "tailwind-merge": "^3.0.1",
        "typescript": "^5.7.3",
        "unhead": "^1.11.18",
        "unocss": "^65.4.3",
        "unocss-preset-animations": "^1.1.1",
        "unocss-preset-useful": "^0.9.2",
        "unplugin-auto-import": "^19.0.0",
        "vite": "^6.1.0",
        "vite-plugin-svgr": "^4.3.0",
        "zod": "^3.24.2",
        "zustand": "^5.0.3"
    },
    "simple-git-hooks": {
        "pre-commit": [
            "pnpm lint-staged"
        ]
    },
    "lint-staged": {
        "*": [
            "eslint --fix"
        ]
    }
}
